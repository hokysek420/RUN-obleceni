generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  slug              String           @unique
  category          String
  price             Int
  sale_price        Int?
  currency          String           @default("CZK")
  sku               String
  status            String           @default("SKLADEM") // SKLADEM, PŘEDOBJEDNÁVKA, VYPRODÁNO, LIMITOVANÁ EDICE
  is_featured       Int              @default(0)
  is_new_drop       Int              @default(0)
  release_date      String?
  expected_shipping String?
  preorder_info     String?
  description       String
  material          String
  grammage          String
  fit               String
  care_instructions String
  warranty          String
  certificate_id    String?
  primary_image     String
  gallery           String           // JSON string array of image URLs
  video_url         String?
  model_3d_url      String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @default(now()) @updatedAt

  variants          ProductVariant[]
  reviews           Review[]
  wishlist_items    Wishlist[]

  @@map("products")
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  product_id     Int
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  size           String
  color          String
  sku            String
  stock          Int      @default(10)
  reserved_stock Int      @default(0)

  @@map("product_variants")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  image       String?

  @@map("categories")
}

model Collection {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  badge       String?
  description String?
  hero_image  String?

  @@map("collections")
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password_hash String
  first_name    String
  last_name     String
  phone         String?
  street        String?
  city          String?
  zip           String?
  country       String     @default("Česká republika")
  created_at    DateTime   @default(now())
  updated_at    DateTime   @default(now()) @updatedAt

  orders        Order[]
  wishlist      Wishlist[]

  @@map("users")
}

model AdminUser {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("ADMIN") // OWNER, ADMIN, CONTENT_MANAGER
  created_at    DateTime @default(now())

  @@map("admin_users")
}

model Order {
  id                    Int         @id @default(autoincrement())
  order_number          String      @unique
  user_id               Int?
  user                  User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name         String
  customer_email        String
  customer_phone        String
  shipping_street       String
  shipping_city         String
  shipping_zip          String
  shipping_country      String
  billing_street        String?
  billing_city          String?
  billing_zip           String?
  billing_country       String?
  delivery_method       String
  delivery_pickup_point String?
  shipping_price        Int         @default(0)
  payment_method        String
  payment_status        String      @default("Čeká na platbu") // Čeká na platbu, Zaplaceno, Vráceno
  order_status          String      @default("Přijato")        // Přijato, Zaplaceno, Zpracovává se, Odesláno, Doručeno, Stornováno, Vráceno
  carrier               String?
  tracking_number       String?
  tracking_link         String?
  discount_code         String?
  discount_amount       Int         @default(0)
  gift_card_code        String?
  gift_card_amount      Int         @default(0)
  subtotal              Int
  total                 Int
  internal_notes        String?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @default(now()) @updatedAt

  items                 OrderItem[]

  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  order_id      Int
  order         Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id    Int
  product_name  String
  product_image String
  size          String
  color         String
  price         Int
  quantity      Int
  total         Int

  @@map("order_items")
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id Int
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_id, product_id])
  @@map("wishlist")
}

model Review {
  id                Int      @id @default(autoincrement())
  product_id        Int
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_name     String
  customer_email    String
  rating            Int
  title             String
  comment           String
  photo_url         String?
  verified_purchase Int      @default(1)
  status            String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  created_at        DateTime @default(now())

  @@map("reviews")
}

model ReturnAndReclamation {
  id             Int      @id @default(autoincrement())
  type           String   // RETURN, RECLAMATION
  order_number   String
  customer_name  String
  customer_email String
  customer_phone String
  product_name   String
  reason         String
  description    String
  photo_urls     String?  // JSON array string
  bank_account   String?
  status         String   @default("Čeká na posouzení")
  admin_notes    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  @@map("returns_and_reclamations")
}

model DiscountCode {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  type       String   @default("PERCENT") // PERCENT, FIXED
  value      Int
  min_order  Int      @default(0)
  max_uses   Int?
  times_used Int      @default(0)
  expires_at String?
  is_active  Int      @default(1)

  @@map("discount_codes")
}

model GiftCard {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  initial_balance Int
  current_balance Int
  currency        String   @default("CZK")
  recipient_email String?
  is_active       Int      @default(1)
  created_at      DateTime @default(now())

  @@map("gift_cards")
}

model Appointment {
  id             Int      @id @default(autoincrement())
  customer_name  String
  customer_email String
  customer_phone String
  type           String
  date           String
  time           String
  notes          String?
  status         String   @default("PENDING")
  created_at     DateTime @default(now())

  @@map("appointments")
}

model CommunityGallery {
  id             Int      @id @default(autoincrement())
  author_name    String
  author_handle  String?
  image_url      String
  caption        String?
  product_tagged String?
  status         String   @default("APPROVED")
  created_at     DateTime @default(now())

  @@map("community_gallery")
}

model NewsletterSubscriber {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  consent_given Int      @default(1)
  created_at    DateTime @default(now())

  @@map("newsletter_subscribers")
}

model MediaLibrary {
  id         Int      @id @default(autoincrement())
  filename   String
  url        String
  type       String   @default("image")
  size       Int      @default(0)
  alt_text   String?
  created_at DateTime @default(now())

  @@map("media_library")
}

model WebsiteContent {
  key        String   @id
  value      String   @db.Text
  updated_at DateTime @default(now()) @updatedAt

  @@map("website_content")
}

model StoreSetting {
  key        String   @id
  value      String   @db.Text
  updated_at DateTime @default(now()) @updatedAt

  @@map("store_settings")
}
