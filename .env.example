# ========================================================
# RUN CLOTHING BRAND — ENVIRONMENT CONFIGURATION
# ========================================================

# Application URL & Branding
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="RUN Clothing"
NEXT_PUBLIC_CURRENCY="CZK"
PORT=3000

# Authentication Secrets (JWT)
JWT_SECRET=run_clothing_customer_jwt_secret_key_2026_super_secure
ADMIN_JWT_SECRET=run_clothing_admin_master_secret_key_2026_top_level

# Database Connection (PostgreSQL - Neon / Supabase / Railway)
# For Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# For Neon Serverless Postgres:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/runclothing?sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/run_clothing"
